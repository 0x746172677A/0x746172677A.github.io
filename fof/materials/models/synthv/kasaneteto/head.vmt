"VertexLitGeneric"
{
	"$basetexture" "models/synthv/kasaneteto/texture/head"
	$detail models/survivors/survivor_it
	$lightwarptexture "models/synthv/kasaneteto/lightwarps/body"

		$nodecal 1

    $detailscale 3
    $detailblendfactor 0.0
    $detailblendmode 0
	
	$ITAmount 0.0
    $ONE 1.0

    Proxies {
        IT {
            resultVar $ITAmount
        }
        Equals {
            srcVar1 $ITAmount
            resultVar $detailblendfactor
        }
        Subtract {
            srcVar1 $ONE
            srcVar2 $ITAmount
            resultVar $phongboost
        }
    }
}
